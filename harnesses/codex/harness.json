{
  "name": "codex",
  "bootstrap": {
    "supported": true,
    "shape": "A",
    "native_key": "hookSpecificOutput.additionalContext",
    "forbidden_keys": ["additional_context"],
    "command": "__COACUS_PYTHON__ \"__COACUS_ROOT__/scripts/coacus_session_start.py\" \"__COACUS_ROOT__/harnesses/codex/bootstrap/session-start.json\"",
    "hooks_config": {
      "hooks": {
        "SessionStart": [
          {
            "matcher": "startup|resume|clear|compact",
            "hooks": [
              {
                "type": "command",
                "command": "__COACUS_PYTHON__ \"__COACUS_ROOT__/scripts/coacus_session_start.py\" \"__COACUS_ROOT__/harnesses/codex/bootstrap/session-start.json\"",
                "additionalContextLimit": 7000
              }
            ]
          }
        ]
      }
    },
    "outputs": [
      { "path": "harnesses/codex/bootstrap/session-start.json", "format": "json" },
      { "path": "harnesses/codex/bootstrap/hooks.json", "format": "json" }
    ]
  },
  "detection": ["CODEX_HOME"],
  "live_cli": ["codex", "exec"],
  "lifecycle": {
    "schema": 1,
    "supported": true,
    "in_process": false,
    "trust_gate": true,
    "config": { "container": "hooks", "merge": "merge", "hooks_file": "harnesses/codex/bootstrap/guardrail-hooks.json" },
    "composition": "composable",
    "ordering": "coacus-last",
    "events": {
      "tool.pre": { "support": "gate", "can_block": true, "can_ask": false, "effect": "permissionDecision", "evidence": "documented", "resolved": "2026-09-30", "source": "https://developers.openai.com/codex/hooks" },
      "prompt.submit": { "support": "gate", "can_block": false, "can_ask": false, "effect": "additionalContext", "evidence": "documented", "resolved": "2026-09-30", "source": "https://developers.openai.com/codex/hooks" },
      "turn.stop": { "support": "gate", "can_block": true, "can_ask": false, "effect": "decision", "evidence": "documented", "resolved": "2026-09-30", "source": "https://developers.openai.com/codex/hooks" },
      "tool.post": { "support": "observe", "can_block": false, "can_ask": false, "effect": "additionalContext", "evidence": "documented", "resolved": "2026-09-30", "source": "https://developers.openai.com/codex/hooks" },
      "tool.failure": { "support": "observe", "can_block": false, "can_ask": false, "effect": "additionalContext", "derived": true, "from": "tool.post", "evidence": "documented", "resolved": "2026-09-30", "source": "https://developers.openai.com/codex/hooks" },
      "session.start": { "support": "lifecycle", "can_block": false, "can_ask": false, "effect": "additionalContext", "evidence": "documented", "resolved": "2026-09-30", "source": "https://developers.openai.com/codex/hooks" },
      "session.end": { "support": "lifecycle", "can_block": false, "can_ask": false, "effect": "advisory", "evidence": "documented", "resolved": "2026-09-30", "source": "https://developers.openai.com/codex/hooks" },
      "context.precompact": { "support": "lifecycle", "can_block": false, "can_ask": false, "effect": "observe", "evidence": "documented", "resolved": "2026-09-30", "source": "https://developers.openai.com/codex/hooks" },
      "subagent.start": { "support": "lifecycle", "can_block": false, "can_ask": false, "effect": "additionalContext", "evidence": "documented", "resolved": "2026-09-30", "source": "https://developers.openai.com/codex/hooks" },
      "subagent.stop": { "support": "lifecycle", "can_block": true, "can_ask": false, "effect": "decision", "evidence": "documented", "resolved": "2026-09-30", "source": "https://developers.openai.com/codex/hooks" }
    },
    "gaps": [
      { "event": "session.end", "status": "advisory", "reason": "SessionEnd is advisory on Codex; it cannot block" },
      { "event": "tool.pre", "status": "trust-gate", "reason": "Codex refuses to run an untrusted hook until the operator approves it" }
    ]
  },
  "plugins": [
    { "path": "harnesses/codex/bootstrap/guardrail-hooks.json", "kind": "guardrail" }
  ],
  "tool_mapping": {
    "create or update todos": "update_plan",
    "dispatch a subagent": "spawn_agent",
    "invoke a skill": "skill",
    "read a file": "read",
    "create, edit, or delete files": "apply_patch",
    "run shell commands": "shell",
    "search files": "grep / glob",
    "fetch a URL": "web_search",
    "find a Coacus skill outside the visible list": "shell: python3 __COACUS_ROOT__/scripts/coacus_skill_search.py search <words>; read the returned SKILL.md"
  },
  "tool_denylist": ["update_plan", "spawn_agent", "apply_patch"],
  "install": {
    "method": "skills to ~/.agents/skills/ (Codex scans .agents/skills, not ~/.codex/skills) and the SessionStart hook as ~/.codex/hooks.json (or a plugin's hooks/hooks.json)",
    "target": "{config_dir}/hooks.json"
  }
}
