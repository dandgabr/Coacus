{
  "name": "claude-code",
  "bootstrap": {
    "supported": true,
    "shape": "A",
    "native_key": "hookSpecificOutput.additionalContext",
    "forbidden_keys": ["additional_context"],
    "command": "__COACUS_PYTHON__ \"__COACUS_ROOT__/scripts/coacus_session_start.py\" \"__COACUS_PLUGIN_ROOT__/bootstrap/session-start.json\"",
    "hooks_config": {
      "hooks": {
        "SessionStart": [
          {
            "matcher": "startup|clear|compact",
            "hooks": [
              {
                "type": "command",
                "command": "__COACUS_PYTHON__ \"__COACUS_ROOT__/scripts/coacus_session_start.py\" \"__COACUS_PLUGIN_ROOT__/bootstrap/session-start.json\"",
                "async": false
              }
            ]
          }
        ]
      }
    },
    "outputs": [
      { "path": "harnesses/claude-code/bootstrap/session-start.json", "format": "json" },
      { "path": "harnesses/claude-code/bootstrap/hooks.json", "format": "json" }
    ]
  },
  "detection": ["CLAUDE_PLUGIN_ROOT"],
  "lifecycle": {
    "schema": 1,
    "supported": true,
    "in_process": false,
    "config": {
      "container": "hooks",
      "merge": "merge",
      "hooks_file": "harnesses/claude-code/bootstrap/guardrail-hooks.json"
    },
    "composition": "composable",
    "ordering": "coacus-last",
    "events": {
      "tool.pre": { "support": "gate", "can_block": true, "can_ask": true, "effect": "permissionDecision", "evidence": "documented", "resolved": "2026-09-30", "source": "https://docs.claude.com/en/docs/claude-code/hooks" },
      "prompt.submit": { "support": "gate", "can_block": true, "can_ask": true, "effect": "additionalContext", "evidence": "documented", "resolved": "2026-09-30", "source": "https://docs.claude.com/en/docs/claude-code/hooks" },
      "turn.stop": { "support": "gate", "can_block": true, "can_ask": false, "effect": "decision", "evidence": "documented", "resolved": "2026-09-30", "source": "https://docs.claude.com/en/docs/claude-code/hooks" },
      "tool.post": { "support": "observe", "can_block": false, "can_ask": false, "effect": "additionalContext", "evidence": "documented", "resolved": "2026-09-30", "source": "https://docs.claude.com/en/docs/claude-code/hooks" },
      "tool.failure": { "support": "observe", "can_block": false, "can_ask": false, "effect": "additionalContext", "evidence": "documented", "resolved": "2026-09-30", "source": "https://docs.claude.com/en/docs/claude-code/hooks" },
      "session.start": { "support": "lifecycle", "can_block": false, "can_ask": false, "effect": "additionalContext", "evidence": "documented", "resolved": "2026-09-30", "source": "https://docs.claude.com/en/docs/claude-code/hooks" },
      "session.end": { "support": "lifecycle", "can_block": false, "can_ask": false, "effect": "advisory", "evidence": "documented", "resolved": "2026-09-30", "source": "https://docs.claude.com/en/docs/claude-code/hooks" },
      "context.precompact": { "support": "lifecycle", "can_block": true, "can_ask": false, "effect": "decision", "evidence": "documented", "resolved": "2026-09-30", "source": "https://docs.claude.com/en/docs/claude-code/hooks" },
      "subagent.start": { "support": "lifecycle", "can_block": false, "can_ask": false, "effect": "additionalContext", "derived": false, "evidence": "documented", "resolved": "2026-09-30", "source": "https://docs.claude.com/en/docs/claude-code/hooks" },
      "subagent.stop": { "support": "lifecycle", "can_block": true, "can_ask": false, "effect": "decision", "evidence": "documented", "resolved": "2026-09-30", "source": "https://docs.claude.com/en/docs/claude-code/hooks" }
    }
  },
  "plugins": [
    { "path": "harnesses/claude-code/bootstrap/guardrail-hooks.json", "kind": "guardrail" }
  ],
  "tool_mapping": {
    "create or update todos": "TodoWrite",
    "dispatch a subagent": "Task",
    "invoke a skill": "Skill",
    "read a file": "Read",
    "create, edit, or delete files": "Write / Edit",
    "run shell commands": "Bash",
    "search files": "Grep / Glob",
    "fetch a URL": "WebFetch"
  },
  "tool_denylist": ["TodoWrite", "WebFetch", "WebSearch", "NotebookEdit"],
  "install": {
    "method": "publish as a plugin (.claude-plugin/plugin.json + marketplace) and install via '/plugin marketplace add' + '/plugin install'; skills also load from ~/.claude/skills/ and agents from ~/.claude/agents/",
    "target": "plugin marketplace"
  }
}
