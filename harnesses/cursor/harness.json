{
  "name": "cursor",
  "bootstrap": {
    "supported": true,
    "shape": "A",
    "native_key": "additional_context",
    "forbidden_keys": ["additionalContext", "hookSpecificOutput"],
    "hooks_config": {
      "version": 1,
      "hooks": {
        "sessionStart": [
          { "command": "__COACUS_ROOT__/harnesses/cursor/bootstrap/session-start.sh" }
        ]
      }
    },
    "outputs": [
      { "path": "harnesses/cursor/bootstrap/session-start.sh", "format": "sh" },
      { "path": "harnesses/cursor/bootstrap/hooks.json", "format": "json" }
    ]
  },
  "detection": ["CURSOR_TRACE_ID", "CURSOR_PLUGIN_ROOT"],
  "lifecycle": {
    "schema": 1,
    "supported": true,
    "in_process": false,
    "config": { "container": "hooks", "merge": "merge", "hooks_file": "harnesses/cursor/bootstrap/guardrail-hooks.json" },
    "composition": "composable",
    "ordering": "coacus-last",
    "events": {
      "tool.pre": { "support": "gate", "can_block": true, "can_ask": true, "effect": "permission", "evidence": "documented", "resolved": "2026-09-30", "source": "https://cursor.com/docs/agent/hooks" },
      "prompt.submit": { "support": "gate", "can_block": true, "can_ask": false, "effect": "continue", "evidence": "documented", "resolved": "2026-09-30", "source": "https://cursor.com/docs/agent/hooks" },
      "turn.stop": { "support": "gate", "can_block": true, "can_ask": false, "effect": "followup_message", "evidence": "documented", "resolved": "2026-09-30", "source": "https://cursor.com/docs/agent/hooks" },
      "tool.post": { "support": "observe", "can_block": false, "can_ask": false, "effect": "additional_context", "evidence": "documented", "resolved": "2026-09-30", "source": "https://cursor.com/docs/agent/hooks" },
      "tool.failure": { "support": "observe", "can_block": false, "can_ask": false, "effect": "additional_context", "derived": true, "from": "tool.post", "evidence": "documented", "resolved": "2026-09-30", "source": "https://cursor.com/docs/agent/hooks" },
      "session.start": { "support": "lifecycle", "can_block": false, "can_ask": false, "effect": "additional_context", "evidence": "documented", "resolved": "2026-09-30", "source": "https://cursor.com/docs/agent/hooks" },
      "session.end": { "support": "lifecycle", "can_block": false, "can_ask": false, "effect": "advisory", "evidence": "documented", "resolved": "2026-09-30", "source": "https://cursor.com/docs/agent/hooks" },
      "context.precompact": { "support": "lifecycle", "can_block": false, "can_ask": false, "effect": "observe", "evidence": "documented", "resolved": "2026-09-30", "source": "https://cursor.com/docs/agent/hooks" },
      "subagent.start": { "support": "lifecycle", "can_block": true, "can_ask": false, "effect": "permission", "evidence": "documented", "resolved": "2026-09-30", "source": "https://cursor.com/docs/agent/hooks" },
      "subagent.stop": { "support": "lifecycle", "can_block": false, "can_ask": false, "effect": "advisory", "evidence": "documented", "resolved": "2026-09-30", "source": "https://cursor.com/docs/agent/hooks" }
    },
    "gaps": [
      { "event": "tool.pre", "status": "unverified", "reason": "project vs user hooks.json precedence is unverified; a user-scope deny must be probed before trust" }
    ]
  },
  "plugins": [
    { "path": "harnesses/cursor/bootstrap/coacus-guard.sh", "kind": "guardrail" }
  ],
  "tool_mapping": {
    "create or update todos": "todo write",
    "dispatch a subagent": "task",
    "invoke a skill": "skill",
    "read a file": "read",
    "create, edit, or delete files": "edit",
    "run shell commands": "terminal",
    "search files": "grep / glob",
    "fetch a URL": "fetch"
  },
  "tool_denylist": [],
  "install": {
    "method": "place the SessionStart hook at <project>/.cursor/hooks.json (or ~/.cursor/hooks.json) referencing the script; ship skills in a .cursor/skills/ or .agents/skills/ tree and agents at ~/.cursor/agents/<name>.md; package as a Cursor Plugin via .cursor-plugin/plugin.json",
    "target": ".cursor/hooks.json"
  }
}
