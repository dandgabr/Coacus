{
  "name": "antigravity",
  "bootstrap": {
    "supported": true,
    "shape": "C",
    "outputs": [
      { "path": "harnesses/antigravity/bootstrap/ANTIGRAVITY.md", "format": "md" },
      { "path": "harnesses/antigravity/bootstrap/plugin.json", "format": "json" }
    ]
  },
  "detection": ["GEMINI_DIR", "ANTIGRAVITY"],
  "tool_mapping": {
    "create or update todos": "task artifact",
    "dispatch a subagent": "invoke_subagent",
    "invoke a skill": "skillPaths discovery",
    "read a file": "read_file",
    "create, edit, or delete files": "write_to_file / replace_file_content",
    "run shell commands": "run_command",
    "search files": "search files",
    "fetch a URL": "fetch URL"
  },
  "tool_denylist": ["google_web_search", "read_file", "write_file", "list_directory", "run_command", "write_to_file", "replace_file_content", "invoke_subagent"],
  "install": {
    "method": "stage the plugin (manifest, context file, skills) and register its path in plugins.json",
    "target": "{config_dir}/config/plugins.json"
  }
}
