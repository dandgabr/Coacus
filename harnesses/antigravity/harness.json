{
  "name": "antigravity",
  "bootstrap": {
    "supported": true,
    "shape": "C",
    "outputs": [
      { "path": "harnesses/antigravity/bootstrap/coacus-rule.md", "format": "md" },
      { "path": "harnesses/antigravity/bootstrap/plugin.json", "format": "json" }
    ]
  },
  "detection": ["GEMINI_DIR", "ANTIGRAVITY"],
  "live_cli": ["agy", "--print"],
  "lifecycle": {
    "schema": 1,
    "supported": true,
    "in_process": false,
    "config": { "container": "coacus-guard", "merge": "plugin", "hooks_file": "harnesses/antigravity/bootstrap/guardrail-hooks.json" },
    "composition": "composable",
    "ordering": "coacus-last",
    "events": {
      "tool.pre": { "support": "gate", "can_block": true, "can_ask": true, "effect": "decision", "evidence": "documented", "resolved": "2026-09-30", "source": "https://antigravity.google/docs/hooks" },
      "tool.post": { "support": "observe", "can_block": false, "can_ask": false, "effect": "none", "evidence": "documented", "resolved": "2026-09-30", "source": "https://antigravity.google/docs/hooks" },
      "session.start": { "support": "none", "can_block": false, "can_ask": false, "effect": null, "evidence": "documented", "resolved": "2026-09-30", "source": "https://antigravity.google/docs/hooks" },
      "turn.stop": { "support": "gate", "can_block": true, "can_ask": false, "effect": "decision", "evidence": "documented", "resolved": "2026-09-30", "source": "https://antigravity.google/docs/hooks" }
    },
    "gaps": [
      { "event": "session.start", "status": "unsupported", "reason": "Antigravity has no SessionStart event; only an always_on rule" },
      { "event": "session.end", "status": "unsupported", "reason": "no session-end event" },
      { "event": "subagent.start", "status": "emulate", "reason": "only via PreToolUse on the spawn tool" }
    ]
  },
  "plugins": [
    { "path": "harnesses/antigravity/bootstrap/governor-hook.sh", "kind": "governor-gate" },
    { "path": "harnesses/antigravity/bootstrap/coacus-guard.sh", "kind": "guardrail" }
  ],
  "tool_mapping": {
    "create or update todos": "manage_task (task artifact)",
    "dispatch a subagent": "invoke_subagent",
    "invoke a skill": "Skill tool (skillPaths discovery)",
    "read a file": "view_file",
    "create, edit, or delete files": "write_to_file / replace_file_content",
    "run shell commands": "run_command",
    "search files": "grep_search / find_by_name",
    "fetch a URL": "read_url_content"
  },
  "tool_denylist": ["view_file", "write_to_file", "replace_file_content", "multi_replace_file_content", "list_dir", "find_by_name", "grep_search", "search_web", "read_url_content", "run_command", "manage_task", "invoke_subagent", "send_message", "manage_subagents"],
  "install": {
    "method": "stage the plugin (manifest, rule file, skills) under <config>/config/plugins/coacus/; place the rule in .agents/rules/ or the plugin rules/ dir; optionally 'agy plugin install <dir>'",
    "target": "{config_dir}/config/plugins"
  }
}
