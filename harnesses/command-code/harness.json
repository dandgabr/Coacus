{
  "name": "command-code",
  "bootstrap": {
    "supported": true,
    "shape": "A",
    "native_key": "hookSpecificOutput.additionalContext",
    "forbidden_keys": ["additional_context"],
    "command": "__COACUS_PYTHON__ \"__COACUS_ROOT__/scripts/coacus_session_start.py\" \"__COACUS_ROOT__/harnesses/command-code/bootstrap/session-start.json\"",
    "hooks_config": {
      "hooks": {
        "SessionStart": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "__COACUS_PYTHON__ \"__COACUS_ROOT__/scripts/coacus_session_start.py\" \"__COACUS_ROOT__/harnesses/command-code/bootstrap/session-start.json\""
              }
            ]
          }
        ]
      }
    },
    "outputs": [
      { "path": "harnesses/command-code/bootstrap/session-start.json", "format": "json" },
      { "path": "harnesses/command-code/bootstrap/hooks.json", "format": "json" }
    ]
  },
  "detection": ["COMMANDCODE_PROJECT_DIR"],
  "lifecycle": {
    "schema": 1,
    "supported": true,
    "in_process": false,
    "config": { "container": "hooks", "merge": "settings", "hooks_file": "harnesses/command-code/bootstrap/guardrail-hooks.json" },
    "composition": "composable",
    "ordering": "coacus-last",
    "events": {
      "tool.pre": { "support": "gate", "can_block": true, "can_ask": false, "effect": "permissionDecision", "evidence": "documented", "resolved": "2026-09-30", "source": "https://commandcode.ai/docs/hooks" },
      "turn.stop": { "support": "gate", "can_block": true, "can_ask": false, "effect": "decision", "cap": 3, "evidence": "documented", "resolved": "2026-09-30", "source": "https://commandcode.ai/docs/hooks" },
      "tool.post": { "support": "observe", "can_block": false, "can_ask": false, "effect": "decision", "evidence": "documented", "resolved": "2026-09-30", "source": "https://commandcode.ai/docs/hooks" },
      "tool.failure": { "support": "observe", "can_block": false, "can_ask": false, "effect": "decision", "derived": true, "from": "tool.post", "evidence": "documented", "resolved": "2026-09-30", "source": "https://commandcode.ai/docs/hooks" },
      "session.start": { "support": "lifecycle", "can_block": false, "can_ask": false, "effect": "additionalContext", "evidence": "documented", "resolved": "2026-09-30", "source": "https://commandcode.ai/docs/hooks" }
    },
    "gaps": [
      { "event": "session.start", "status": "never-blocks", "reason": "SessionStart is non-blocking by design on Command Code" },
      { "event": "session.end", "status": "unsupported", "reason": "no SessionEnd hook" },
      { "event": "subagent.start", "status": "unsupported", "reason": "the agent tool cannot be intercepted by a hook" },
      { "event": "tool.pre", "status": "plan-mode-skip", "reason": "hooks are skipped entirely in plan mode" }
    ]
  },
  "plugins": [
    { "path": "harnesses/command-code/bootstrap/guardrail-hooks.json", "kind": "guardrail" }
  ],
  "tool_mapping": {
    "create or update todos": "todo_write",
    "dispatch a subagent": "agent",
    "invoke a skill": "skill",
    "read a file": "read_file",
    "create, edit, or delete files": "write_file / edit_file",
    "run shell commands": "shell_command",
    "search files": "grep / glob",
    "fetch a URL": "web_fetch"
  },
  "tool_denylist": ["todo_write", "agent_output"],
  "install": {
    "method": "skills mirror to ~/.agents/skills/ (a Command Code user scan root); agents to <config>/agents/<name>.md with tools: \"*\"; the SessionStart bootstrap is merged into <config>/settings.json under the 'hooks' key (never a separate hooks.json); the context7 MCP is merged into <config>/mcp.json under 'mcpServers'; the Coacus user rules land at <config>/AGENTS.md only when that file is absent",
    "target": "{config_dir}/settings.json"
  }
}
